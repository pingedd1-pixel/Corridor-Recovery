# Corridor Recovery — environment (copy to .env; .env is never committed)
# Postgres connection. Leave unset to run on an embedded PGlite store in ./data (dev only).
DATABASE_URL=
# Where the embedded dev store lives when DATABASE_URL is unset
PGLITE_DIR=./data/pglite
# HTTP
PORT=3000
HOST=127.0.0.1
# Desk timezone — the engine's "today" and all deadline math run in this zone
TZ=America/Vancouver
# Anthropic (M3: bulletin parsing, PDF ingestion). Not used in M1.
ANTHROPIC_API_KEY=
